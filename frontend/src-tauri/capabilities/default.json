{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the desktop app (low-privilege base layer).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "dialog:default",
    "notification:default",
    "os:allow-platform",
    "os:allow-version",
    "shell:allow-open",
    "store:default",
    "updater:default",
    "autostart:default",
    "deep-link:default",
    "stronghold:default"
  ]
}
