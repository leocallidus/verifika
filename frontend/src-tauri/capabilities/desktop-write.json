{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-write",
  "description": "Write-scope capability: the only place the webview is allowed to write files. Reads/writes inside $DOWNLOADS only.",
  "windows": ["main"],
  "permissions": [
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOADS" },
        { "path": "$DOWNLOADS/**" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**" }
      ]
    }
  ]
}
