DATABASE_URL=postgresql+asyncpg://postgres:12345678@localhost:5432/verifika
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
LOG_LEVEL=INFO
BCRYPT_ROUNDS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESET_LINK_TTL=1800
PUBLIC_BASE_URL=http://localhost:5173

# ── AI MODULE (Polza.ai) ───────────────────────────────────
# Установите AI_ENABLED=true и введите ваш AI_API_KEY для активации.
# Получите ключ на https://polza.ai/dashboard

AI_ENABLED=false

# Разрешить ИИ-Ассистента для роли «студент».
# true  — студенты имеют доступ к чату (по умолчанию)
# false — студенты получают 403; преподаватели и admin не затронуты
AI_STUDENT_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://polza.ai/api/v1

# Модели (список доступных: https://polza.ai/models)
AI_CHAT_MODEL=anthropic/claude-sonnet-4-5-20250929
AI_GENERATION_MODEL=openai/gpt-4o

# Параметры чата
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=4096
AI_CONTEXT_WINDOW=20

# Параметры генерации вопросов
AI_GEN_TEMPERATURE=0.3
AI_GEN_MAX_TOKENS=8192
AI_MAX_QUESTIONS_PER_REQUEST=50

# Системный промпт ассистента (однострочный)
AI_SYSTEM_PROMPT=Ты — педагогический ИИ-ассистент платформы Верифика. Помогай преподавателям создавать качественные учебные материалы и отвечай на вопросы студентов.

# Таймаут запроса к ИИ (секунды)
AI_REQUEST_TIMEOUT=60

# ── AI MODULE v2 ──────────────────────────────────────────
# Дневные лимиты для студентов (0 = без лимита)
AI_DAILY_TOKEN_LIMIT_STUDENT=0
AI_DAILY_MESSAGE_LIMIT_STUDENT=50

# Разрешённые модели генерации, доступные для выбора в UI (CSV)
AI_GENERATION_MODELS_ALLOWED=openai/gpt-4o,anthropic/claude-sonnet-4-5-20250929

# Максимум символов входного материала для генерации по тексту
AI_GEN_MATERIAL_MAX_CHARS=12000


